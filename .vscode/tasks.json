{
  "version": "2.0.0",

  "tasks": [
    {
      "label": "总任务（依赖链）",
      "dependsOn": ["构建&复制", "复制配置文件", "复制bin文件夹"],
      "dependsOrder": "parallel", // 并行执行
      "problemMatcher": []
    },

    {
      "label": "构建&复制",
      "dependsOn": ["构建release版本", "复制二进制文件"],
      "dependsOrder": "sequence", // 按顺序执行
      "problemMatcher": []
    },

    {
      "label": "构建release版本",
      "type": "cargo",
      "command": "b",
      "args": ["-r"],
      "problemMatcher": ["$rustc"],
      "group": "build"
    },

    {
      "label": "复制二进制文件",
      "type": "shell",
      "command": "xcopy",
      "args": ["/Y", "target\\release\\rust_snapshot_backup.exe", "deploy\\"],
      "problemMatcher": []
    },

    {
      "label": "复制配置文件",
      "type": "shell",
      "command": "xcopy",
      "args": ["/Y", "config\\@template.toml", "deploy\\config\\"],
      "problemMatcher": []
    },

    {
      "label": "复制bin文件夹",
      "type": "shell",
      "command": "xcopy",
      "args": ["/E", "/Y", "bin", "deploy\\bin\\"],
      "problemMatcher": []
    }
  ]
}
